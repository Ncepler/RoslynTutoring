# Copy to .env.local for local development, and add the same keys in Vercel
# (Project → Settings → Environment Variables). Never commit real values.
# Anything left blank degrades gracefully; see README.md.

# --- Site ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Shared group inbox (placeholder until it exists)
NEXT_PUBLIC_CONTACT_EMAIL=hello@example.com

# --- Supabase (free tier) ---
# Without these two the site runs in preview mode on sample data.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server only. Used by the booking route, Stripe webhook and cron. Bypasses RLS.
SUPABASE_SECRET_KEY=

# --- Email: Resend (free tier: 3,000/month, 100/day) ---
# Without a key, emails are logged to the console instead of sent.
RESEND_API_KEY=
# Must be on a domain verified in Resend before it can email students and parents.
EMAIL_FROM="Tutoring <hello@example.com>"
# Fallback admin recipients if the database can't be read (comma separated)
ADMIN_EMAILS=

# --- Payments: Stripe ---
# Without a key, accepting a request works but no payment link is created;
# locally you can use the "Mark as paid (dev only)" button instead.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --- Google Calendar (optional, free) ---
# Service account that tutors share their calendars with.
GOOGLE_SERVICE_ACCOUNT_EMAIL=
# Paste the private key with literal \n for newlines.
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=

# --- Vercel Cron ---
# Any long random string. Vercel sends it to /api/cron/daily automatically.
CRON_SECRET=
